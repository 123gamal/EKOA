# =============================================================================
# EKOA – Environment Configuration Template
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_NAME=ekoa
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=<generate-a-secure-random-key>

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekoa_db
POSTGRES_USER=ekoa_user
POSTGRES_PASSWORD=<your-postgres-password>
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Qdrant (Vector DB)
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=<your-qdrant-api-key-if-needed>
#
# Note: Qdrant collections are derived per workspace at runtime via
# ekoa_utils.naming.workspace_collection_name() -> ekoa_{workspace_id[:8]}.
# There is no global QDRANT_COLLECTION setting.

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password-if-needed>
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# (sentence-transformers model id; must match between worker and AI service)

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=<generate-a-secure-jwt-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Connector credentials (encryption at rest)
# -----------------------------------------------------------------------------
# Fernet key used to encrypt connector access tokens (e.g. GitHub PATs) at
# rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is a SEPARATE secret from JWT_SECRET_KEY and must never be derived from
# it. Provide it via env var / secrets manager; never hardcode it.
EKOA_FERNET_KEY=<generate-a-fernet-key>
